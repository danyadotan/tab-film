{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/demo/?$",
      "status": 307,
      "headers": {
        "Location": "https://bouncer.tab-at-work.com/demo"
      }
    },
    {
      "src": "^/desk/$",
      "status": 308,
      "headers": {
        "Location": "/desk"
      }
    },
    {
      "src": "^/desk$",
      "dest": "/desk.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "tab-at-work.com"
        }
      ],
      "dest": "/desk.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "www.tab-at-work.com"
        }
      ],
      "dest": "/desk.html"
    },
    {
      "src": "^/film/$",
      "status": 308,
      "headers": {
        "Location": "/film"
      }
    },
    {
      "src": "^/film$",
      "dest": "/index.html"
    }
  ]
}
